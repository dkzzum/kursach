        "date": "2025-11-16",
        "ts": 1763298041,
        "reply_to_msg_id": 85722,
        "is_reply_to_user": true
    },
    {
        "comment_id": 85726,
        "post_id": 16098,
        "channel_id": -1001923705626,
        "text": "Что у ребенка воровать-то?",
